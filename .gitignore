# ==========================================
# Power BI, Office & Development .gitignore
# ==========================================

# Microsoft Office Temporary Lock Files
~$*.xlsx
~$*.xlsm
~$*.xls
~$*.docx
~$*.pptx
~$*.csv

# Operating System Files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
._*
.Spotlight-V100
.Trashes

# Temporary & Cache Files
*.tmp
*.temp
*.log
*.bak

# Python Caches (if running helper scripts)
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# User Scratch Scripts & Archives
scratch/
_archives/

# ============================================================
# Large Binary Files (>= 1 MB) - Excluded from GitHub
# These files are too large for Git LFS free tier (1 GB limit).
# They remain on your local disk and are referenced in
# each episode's README.md for download.
# ============================================================

